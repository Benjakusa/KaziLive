{
  "openapi": "3.0.0",
  "info": {
    "title": "Job Seeking App API",
    "version": "1.0.0",
    "description": "API for Job Seeking Platform"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {"type": "string"},
                  "username": {"type": "string"},
                  "phone": {"type": "string"},
                  "password": {"type": "string"},
                  "user_type": {"type": "string", "enum": ["jobseeker", "employer", "admin"]}
                }
              }
            }
          }
        },
        "responses": {
          "201": {"description": "Registration successful"},
          "400": {"description": "Invalid input"},
          "409": {"description": "User already exists"}
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "identifier": {"type": "string"},
                  "password": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Login successful"},
          "401": {"description": "Invalid credentials"}
        }
      }
    },
    "/api/employer/profile": {
      "get": {
        "summary": "Get employer profile",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {"description": "Profile retrieved"},
          "403": {"description": "Not an employer account"}
        }
      }
    },
    "/api/employer/jobseekers": {
      "get": {
        "summary": "Search jobseekers",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"name": "job_category", "in": "query", "type": "string"},
          {"name": "availability", "in": "query", "type": "string"},
          {"name": "min_salary", "in": "query", "type": "integer"},
          {"name": "page", "in": "query", "type": "integer"},
          {"name": "per_page", "in": "query", "type": "integer"}
        ],
        "responses": {
          "200": {"description": "List of jobseekers"},
          "402": {"description": "Payment required"}
        }
      }
    },
    "/api/employer/jobseekers/{id}": {
      "get": {
        "summary": "View jobseeker profile",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "type": "integer"}
        ],
        "responses": {
          "200": {"description": "Jobseeker profile"},
          "404": {"description": "Jobseeker not found"}
        }
      }
    },
    "/api/employer/contact/{id}": {
      "post": {
        "summary": "Contact jobseeker",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "type": "integer"}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {"type": "string"},
                  "contact_method": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Message sent"},
          "402": {"description": "Payment required"}
        }
      }
    }
  }
}

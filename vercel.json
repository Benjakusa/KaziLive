{
    "buildCommand": "cd frontend && npm install && npm run build",
    "outputDirectory": "frontend/dist",
    "framework": "vite",
    "env": {
        "VITE_BACKEND_URL": "@backend_url"
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://kazilive-backend.onrender.com/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
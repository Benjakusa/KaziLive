{
    "buildCommand": "npm install && npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "env": {
        "VITE_BACKEND_URL": "https://kazilive-backend.onrender.com"
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://kazilive-backend.onrender.com/api/$1"
        }
    ]
}